# Copy to .env.local and fill in real values. Never commit .env.local.

# Resend (https://resend.com) — powers the quote/contact form's email send.
# Until all three are set, /api/quote returns a friendly "not configured
# yet" error instead of failing silently.
RESEND_API_KEY=
# Recipient of quote-form submissions (a real Firuta inbox).
QUOTE_NOTIFICATION_EMAIL=
# Sender address — must be on a domain verified in Resend.
QUOTE_FROM_EMAIL=

# Base URL used by app/sitemap.ts, app/robots.ts, and canonical/OG metadata.
# Set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.firuta-placeholder-domain.com
