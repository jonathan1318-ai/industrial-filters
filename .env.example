# Copy to .env.local and fill in real values. Never commit .env.local.

# EmailJS (https://dashboard.emailjs.com) — powers the quote/contact
# form's email send, entirely client-side (no server API key). These are
# NEXT_PUBLIC_ on purpose: the public key isn't a secret by EmailJS's
# design — restrict abuse via the dashboard's "Allowed origins" setting
# once the production domain is known, not by hiding this value. Until
# all three are set, the form shows a friendly "not configured yet" error
# instead of failing silently. See docs/SEO.md for the template setup.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudinary (https://cloudinary.com) — optimizes/delivers the hero and
# product-category stock photos in lib/content/data.ts via Cloudinary's
# "fetch" transform (no upload needed). Free tier. Find your cloud name on
# the Cloudinary Console dashboard (top of the page, next to your account
# name) right after signup — no other credentials needed for fetch mode.
# Until this is set, those images fall back to the abstract placeholder
# graphic instead of requesting a broken URL. See lib/cloudinary.ts.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Base URL used by app/sitemap.ts, app/robots.ts, and canonical/OG metadata.
# Set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.firuta-placeholder-domain.com
